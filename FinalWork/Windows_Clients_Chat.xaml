<Window x:Class="FinalWork.Windows_Clients_Chat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalWork"
        mc:Ignorable="d"
        Title="Windows_Clients_Chat" Height="450" Width="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Label FontSize="15" FontWeight="Bold" Margin="10">Message :</Label>
            <Button Margin="3" Padding="20 10" DockPanel.Dock="Right" FontSize="14" Background="#FFD90D0D" Foreground="#FFFAFAFA" FontWeight="Bold">Disconnect</Button>
            <Button Margin="3" Padding="20 10" DockPanel.Dock="Right" Background="Aqua" Foreground="#FFFAFAFA" FontWeight="Bold" Click="CLick_Send_Folder">Send Folders:</Button>
            <Button Margin="3" Padding="20 10" DockPanel.Dock="Right" Background="Aqua" Foreground="#FFFAFAFA" FontWeight="Bold" Click="Click_Send_Image">Send Image</Button>
            <Button Margin="3" Padding="20 10" DockPanel.Dock="Right" Background="#FF4079F5" Foreground="White" FontWeight="Bold" FontSize="14" Click="Click_Send">Send</Button>
            <TextBox x:Name="msgTextBox" VerticalContentAlignment="Center" Margin="5"></TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" FontWeight="Bold" FontSize="25">Chat</TextBlock>
        <ListBox x:Name="ListBoxMessage"></ListBox>
    </DockPanel>
</Window>
