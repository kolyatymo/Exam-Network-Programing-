<Window x:Class="FinalWork.Window_Clients"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalWork"
        mc:Ignorable="d"
        Title="Window_Clients" Height="450" Width="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Label Margin="5" FontSize="20">Name:</Label>
            <TextBlock FontSize="15" x:Name="NameTextBox" Width="150" Background="White" VerticalAlignment="Center"></TextBlock>
            <Label Margin="5" FontSize="20">Ipaddres:</Label>
            <TextBox VerticalContentAlignment="Center" FontSize="15" Width="150">127.0.0.1</TextBox>
            <Label Margin="5" FontSize="20">Port: </Label>
            <TextBox FontSize="15" VerticalContentAlignment="Center" Margin="5">8080</TextBox>
            <Button FontWeight="Bold" Width="120" Click="Button_Okay" Margin="30,0,0,0" Background="GreenYellow" FontSize="20">Connection</Button>
        </ToolBar>
        <Grid x:Name="MainPanel" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Background="GreenYellow" FontSize="20" Margin="5" Click="Button_Check_User" >Checking users:</Button>
            <ListBox Margin="5" SelectionMode="Multiple" VerticalContentAlignment="Center" Height="60" Grid.Column="1" x:Name="Checking_users" ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"></ListBox>
            <Button Grid.Column="2" Background="GreenYellow" FontSize="20" Padding="10" Margin="5" Click="Button_Go_Chat" >Lets move to the Chat</Button>
        </Grid>
        <Grid x:Name="MainPanel2" DockPanel.Dock="Top" Width="1188">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Background="GreenYellow"  FontSize="20" Margin="5" Click="Button_Checking_Contacts">Checking Contacts:</Button>
            <ListBox Margin="5" SelectionMode="Multiple" VerticalContentAlignment="Center" Height="60" Grid.Column="1" x:Name="Checking_contacts" ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"></ListBox>
        </Grid>
        <Button x:Name="ButtonContact" Height="60" Width="250" DockPanel.Dock="Top" Background="GreenYellow" FontSize="20" Margin="5" Grid.Row="1" Click="Button_Contact">Create Contacts:</Button>
        <Button x:Name="ButtonGroup" Height="60" Width="250" DockPanel.Dock="Top" Background="GreenYellow" FontSize="20" Margin="5" Grid.Row="1" Click="Button_Group_Chat">Create Groups Chat:</Button>
    </DockPanel>
</Window>
