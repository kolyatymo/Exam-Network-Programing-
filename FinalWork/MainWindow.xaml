<Window x:Class="FinalWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalWork"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="350">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="5">Choose</TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button FontWeight="Bold" Background="GreenYellow" Margin="0,0,0,10" FontSize="20" Click="Button_Click_Registration">Registration</Button>
            <Button FontWeight="Bold" Background="GreenYellow"  FontSize="20" Grid.Row="1" Click="Button_Click_Login">Login</Button>
        </Grid>
    </DockPanel>
</Window>
